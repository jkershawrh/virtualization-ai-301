{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "correlation_id", "request_sha256", "source_state", "outcome", "reason_codes", "checks", "ai_participated", "authority", "created_at"],
  "properties": {
    "schema_version": {"const": "virtualization-ai.redhat-intel.com/evidence-record/v1"},
    "evidence_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_state": {"enum": ["LIVE", "REHEARSAL", "OFFLINE"]},
    "outcome": {"enum": ["ALLOW_REVIEW", "REFUSE", "ABSTAIN"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "checks": {"type": "object", "additionalProperties": {"type": "string"}},
    "ai_participated": {"type": "boolean"},
    "authority": {"const": "HUMAN_REVIEW_REQUIRED"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
